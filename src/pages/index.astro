---
import { getCollection } from 'astro:content';
// Component Imports
import CallToAction from '../components/CallToAction.astro';
// Page section components
import ContactCTA from '../components/ContactCTA.astro';
import Grid from '../components/Grid.astro';
import Hero from '../components/Hero.astro';
import Icon from '../components/Icon.astro';
import Pill from '../components/Pill.astro';
import BlogPreview from '../components/BlogPreview.astro';
import Skills from '../components/Skills.astro';
// Layout import — provides basic page elements: <head>, <nav>, <footer> etc.
import BaseLayout from '../layouts/BaseLayout.astro';

// Content Fetching: List four most recent blog posts
const blogs = (await getCollection('blog'))
  .sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf())
  .slice(0, 4);
const tools = (await getCollection('tool')).sort((a, b) => (a.data.order ?? 0) - (b.data.order ?? 0));;
// Full Astro Component Syntax:
// https://docs.astro.build/basics/astro-components/
---

<BaseLayout>
  <div class="stack gap-20 lg:gap-48">
    <div class="wrapper stack gap-8 lg:gap-20">
      <header class="hero">
        <Hero
          title="Hello, I'm Beach3 Developer"
          tagline="日本の神奈川県に生まれのフルスタックエンジニアです。年中季節問わずにビーチサンダルを履いています。コーヒーが好きで自分好みのコーヒー豆を探すのが趣味です。"
          align="start"
        >
          <div class="roles">
            <Pill><Icon icon="code" size="1.33em" /> Developer</Pill>
            <Pill><Icon icon="coffee" size="1.33em" /> Coffee</Pill>
            <Pill><Icon icon="island" size="1.33em" /> Beach</Pill>
          </div>
        </Hero>

        <img
          alt="SHONAN CHIGASAKI BEACH"
          width="480"
          height="620"
          src="/assets/portrait.jpg"
        />
      </header>

      <Skills />
    </div>

    <main class="wrapper stack gap-20 lg:gap-48">
      <section class="section with-background with-cta">
        <header class="section-header stack gap-2 lg:gap-4">
          <h3>個人ブログ</h3>
          <p>技術記事やプロジェクトマネジメントに関する記事から日常の出来事を綴るブログです。</p>
        </header>

        <div class="gallery">
          <Grid variant="offset">
            {
              blogs.map((blog) => (
                <li>
                  <BlogPreview blog={blog} />
                </li>
              ))
            }
          </Grid>
        </div>

        <div class="cta">
          <CallToAction href="/blog/">
            View All
            <Icon icon="arrow-right" size="1.2em" />
          </CallToAction>
        </div>
      </section>

      <section class="section with-background bg-variant with-cta">
        <header class="section-header stack gap-2 lg:gap-4">
          <h3>Beach3 Utilities</h3>
          <p>
            ブラウザ上で完結する、シンプルで安全な開発者向けツール集。
            日々の小さな作業を、少しだけ快適にします。
          </p>
        </header>

        <div class="gallery">
          <Grid variant="small">
            {
              tools.map((tool) => (
                <li class="tool-card">
                  <a href={`/tool/${tool.slug}`}>
                    <div class="tool-card-inner">
                      <strong>{tool.data.title}</strong>
                      <p>{tool.data.description}</p>
                      <span class="tool-link">
                        Open
                        <Icon icon="arrow-right" size="1em" />
                      </span>
                    </div>
                  </a>
                </li>
              ))
            }
          </Grid>
        </div>

        <div class="cta">
          <CallToAction href="/tool/">
            View All Tools
            <Icon icon="arrow-right" size="1.2em" />
          </CallToAction>
        </div>
      </section>

    </main>

    <ContactCTA />
  </div>
</BaseLayout>

<style>
  .hero {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2rem;
  }

  .roles {
    display: none;
  }

  .hero img {
    aspect-ratio: 5 / 4;
    object-fit: cover;
    object-position: top;
    border-radius: 1.5rem;
    box-shadow: var(--shadow-md);
  }

  @media (min-width: 50em) {
    .hero {
      display: grid;
      grid-template-columns: 6fr 4fr;
      padding-inline: 2.5rem;
      gap: 3.75rem;
    }

    .roles {
      margin-top: 0.5rem;
      display: flex;
      gap: 0.5rem;
    }

    .hero img {
      aspect-ratio: 3 / 4;
      border-radius: 4.5rem;
      object-fit: cover;
    }
  }

  /* ====================================================== */

  .section {
    display: grid;
    gap: 2rem;
  }

  .with-background {
    position: relative;
  }

  .with-background::before {
    --hero-bg: var(--bg-image-subtle-2);

    content: '';
    position: absolute;
    pointer-events: none;
    left: 50%;
    width: 100vw;
    aspect-ratio: calc(2.25 / var(--bg-scale));
    top: 0;
    transform: translateY(-75%) translateX(-50%);
    background:
      url('/assets/noise.png') top center/220px repeat,
      var(--hero-bg) center center / var(--bg-gradient-size) no-repeat,
      var(--gray-999);
    background-blend-mode: overlay, normal, normal, normal;
    mix-blend-mode: var(--bg-blend-mode);
    z-index: -1;
  }

  .with-background.bg-variant::before {
    --hero-bg: var(--bg-image-subtle-1);
  }

  .section-header {
    justify-self: center;
    text-align: center;
    max-width: 50ch;
    font-size: var(--text-md);
    color: var(--gray-300);
  }

  .section-header h3 {
    font-size: var(--text-2xl);
  }

  @media (min-width: 50em) {
    .section {
      grid-template-columns: repeat(4, 1fr);
      grid-template-areas: 'header header header header' 'gallery gallery gallery gallery';
      gap: 5rem;
    }

    .section.with-cta {
      grid-template-areas: 'header header header cta' 'gallery gallery gallery gallery';
    }

    .section-header {
      grid-area: header;
      font-size: var(--text-lg);
    }

    .section-header h3 {
      font-size: var(--text-4xl);
    }

    .with-cta .section-header {
      justify-self: flex-start;
      text-align: left;
    }

    .gallery {
      grid-area: gallery;
    }

    .cta {
      grid-area: cta;
    }
  }

  .tool-card {
    list-style: none;
  }

  .tool-card a {
    display: block;
    height: 100%;
    padding: 1.75rem;
    border-radius: 1.75rem;
    border: 1px solid var(--gray-800);
    background: var(--gradient-subtle);
    box-shadow: var(--shadow-sm);
    text-decoration: none;
    transition: var(--theme-transition);
  }

  .tool-card a:hover {
    transform: translateY(-6px);
    box-shadow: var(--shadow-lg);
    border-color: var(--accent-regular);
  }

  .tool-card-inner {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    height: 100%;
  }

  .tool-card strong {
    font-size: var(--text-lg);
    color: var(--gray-100);
  }

  .tool-card p {
    font-size: var(--text-sm);
    color: var(--gray-400);
    flex-grow: 1;
    line-height: 1.6;
  }

  .tool-link {
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--accent-regular);
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    transition: var(--theme-transition);
  }

  .tool-card a:hover .tool-link {
    transform: translateX(4px);
  }


  @media (min-width: 50em) {
    .tool-card {
      border-radius: 1.5rem;
      height: 9.5rem;
    }
  }
</style>

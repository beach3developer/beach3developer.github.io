---
const EmailJSPublicKey = import.meta.env.PUBLIC_EMAILJS_PUBLIC_KEY; // EmailJSパブリックキー
const EmailJSServiceID = import.meta.env.PUBLIC_EMAILJS_SERVICE_ID; // あなたのEmailJSサービスID
const EmailJSTemplateID = import.meta.env.PUBLIC_EMAILJS_TEMPLATE_ID; // あなたのテンプレートID
---

<button id="sendMailBtn">問い合わせ送信</button>

<!-- Email.jsライブラリ読み込み -->
<script type="text/javascript"
        src="https://cdn.jsdelivr.net/npm/@emailjs/browser@4/dist/email.min.js" defer>
</script>

<script is:inline define:vars={{EmailJSPublicKey, EmailJSServiceID, EmailJSTemplateID}}>
  document.addEventListener("DOMContentLoaded", () => {
    const sendBtn = document.getElementById("sendMailBtn");

    sendBtn.addEventListener("click", async () => {
      if (!confirm("入力内容を送信しますか？")) return;

      // 入力値をフォームから直接取得
      const name = document.getElementById("name").value;
      const contact_email = document.getElementById("contact_email").value;
      const subject = document.getElementById("subject").value;
      const message = document.getElementById("message").value;

      // Email.js 初期化
      emailjs.init({
        publicKey: EmailJSPublicKey // EmailJSパブリックキー,
      });

      // テンプレート変数
      const templateParams = {
        name,
        contact_email,
        subject,
        message,
      };

      console.log("送信内容:", templateParams);

      // ボタン無効化
      sendBtn.disabled = true;
      sendBtn.textContent = "送信中...";

      try {
        const response = await emailjs.send(
          EmailJSServiceID, // あなたのEmailJSサービスID
          EmailJSTemplateID, // あなたのテンプレートID
          templateParams
        );
      // Success 
        console.log("SUCCESS!", response.status, response.text);
        alert("お問い合わせを送信しました。ありがとうございました！");
        sendBtn.textContent = "送信完了";
        window.location.href = '/';
      } catch (error) {
      // Error
        console.error("FAILED...", error);
        alert("送信に失敗しました。再度お試しください。");
        sendBtn.textContent = "送信する";
        sendBtn.disabled = false;
      }
    });
  });
</script>

<style>
  button {
    position: relative;
    display: flex;
    place-content: center;
    text-align: center;
    padding: 0.56em 2em;
    gap: 0.8em;
    color: var(--accent-text-over);
    text-decoration: none;
    line-height: 1.1;
    border-radius: 999rem;
    overflow: hidden;
    background: var(--gradient-accent-orange);
    box-shadow: var(--shadow-md);
    white-space: nowrap;
    cursor: pointer;
  }

  button:disabled {
    opacity: 0.6;
    cursor: not-allowed;
  }

  @media (min-width: 20em) {
    button {
      font-size: var(--text-lg);
    }
  }

  button::after {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    transition: background-color var(--theme-transition);
    mix-blend-mode: overlay;
  }

  button:focus::after,
  button:hover::after {
    background-color: hsla(var(--gray-999-basis), 0.3);
  }

  @media (min-width: 50em) {
    button {
      padding: 1.125rem 2.5rem;
      font-size: var(--text-xl);
    }
  }
</style>

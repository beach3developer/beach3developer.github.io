---
const title = "Coin Toss | Beach3 Utilities";
---

<section class="coin-toss wrapper">
  <div class="stack gap-10">

    <header class="stack gap-4">
      <h1>Coin Toss</h1>
    </header>

    <div class="card stack gap-8">

      <div class="coin-area">
        <div id="coin" class="coin">
          <div class="side front">表</div>
          <div class="side back">裏</div>
        </div>
      </div>

      <div class="actions">
        <button id="tossBtn" class="btn-primary">Flip Coin</button>
      </div>

      <div id="result" class="result"></div>

    </div>
  </div>
</section>

<script>
const coin = document.getElementById("coin");
const tossBtn = document.getElementById("tossBtn");
const result = document.getElementById("result");

let flipping = false;
let currentRotation = 0;

tossBtn.addEventListener("click", () => {

  if (flipping) return;
  flipping = true;

  result.textContent = "";

  const isHeads = Math.random() < 0.5;

  const spins = 8 + Math.floor(Math.random() * 4);

  const targetFace = isHeads ? 0 : 180;

  const currentFace = currentRotation % 360;

  const faceAdjustment = targetFace - currentFace;

  const rotation = spins * 360 + faceAdjustment;

  currentRotation += rotation;

  coin.style.transform = `rotateY(${currentRotation}deg)`;

  setTimeout(() => {
    result.textContent = isHeads ? "おもて" : "うら";
    flipping = false;
  }, 3000);

});
</script>

<style>
.coin-toss {
  padding: 4rem 1.5rem;
}

.card {
  background: var(--gradient-subtle);
  border: 1px solid var(--gray-800);
  border-radius: 1.75rem;
  box-shadow: var(--shadow-md);
  padding: 2rem;
  text-align: center;
}

.coin-area {
  perspective: 1000px;
  display: flex;
  justify-content: center;
  padding: 2rem 0;
}

.coin {
  width: 140px;
  height: 140px;
  position: relative;
  transform-style: preserve-3d;
  transition: transform 3s cubic-bezier(.17,.67,.35,1.2);
}

.side {
  position: absolute;
  width: 100%;
  height: 100%;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 2.5rem;
  font-weight: bold;
  backface-visibility: hidden;
  border: 4px solid var(--gray-700);
  box-shadow: var(--shadow-md);
}

.front {
  background: var(--gradient-accent);
  color: var(--accent-text-over);
}

.back {
  background: var(--gray-800);
  color: var(--gray-100);
  transform: rotateY(180deg);
}

.actions {
  display: flex;
  justify-content: center;
}

.btn-primary {
  background: var(--gradient-accent);
  border: none;
  padding: 0.9rem 1.5rem;
  border-radius: 1rem;
  font-weight: 600;
  color: var(--accent-text-over);
  cursor: pointer;
  transition: var(--theme-transition);
}

.btn-primary:hover {
  transform: translateY(-2px);
  box-shadow: var(--shadow-md);
}

.result {
  font-size: 1.5rem;
  font-weight: 600;
  color: var(--gray-200);
  min-height: 2rem;
}
</style>
---
const title = "Secure Password Generator | Beach3";
const description = "Free secure password generator. Generate strong passwords with length, symbols, exclusions and multiple output.";
const url = new URL(Astro.url.pathname, Astro.site).toString();
---

<head>
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={url} />

  <!-- OGP -->
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  <meta property="og:url" content={url} />

  <!-- JSON-LD -->
  <script type="application/ld+json">
    {JSON.stringify({
      "@context": "https://schema.org",
      "@type": "SoftwareApplication",
      name: "Secure Password Generator",
      applicationCategory: "SecurityApplication",
      operatingSystem: "All",
      offers: { "@type": "Offer", price: "0" }
    })}
  </script>
</head>

<section class="password-generator">
  <h1>Password Generator</h1>

  <div class="card">

    <div class="controls">
      <label>Length
        <input type="number" id="length" min="4" max="128" value="16">
      </label>

      <label>Count
        <input type="number" id="count" min="1" max="50" value="1">
      </label>

      <label><input type="checkbox" id="uppercase" checked> A-Z</label>
      <label><input type="checkbox" id="lowercase" checked> a-z</label>
      <label><input type="checkbox" id="numbers" checked> 0-9</label>
      <label><input type="checkbox" id="symbols"> Symbols</label>

      <label class="exclude">
        Exclude
        <input type="text" id="exclude" placeholder="0OIl">
      </label>
    </div>

    <div class="strength">
      <div class="strength-bar"><div id="strengthFill"></div></div>
      <span id="strengthText">Strength: -</span>
    </div>

    <button id="generate" class="generate-btn">Generate</button>

    <div id="passwordList" class="password-list"></div>

  </div>
</section>

<script>
const UPPER='ABCDEFGHIJKLMNOPQRSTUVWXYZ';
const LOWER='abcdefghijklmnopqrstuvwxyz';
const NUM='0123456789';
const SYM='!@#$%^&*()_+-=[]{}<>?';

const lengthInput=document.getElementById('length');
const countInput=document.getElementById('count');
const uppercase=document.getElementById('uppercase');
const lowercase=document.getElementById('lowercase');
const numbers=document.getElementById('numbers');
const symbols=document.getElementById('symbols');
const excludeInput=document.getElementById('exclude');
const passwordList=document.getElementById('passwordList');
const strengthFill=document.getElementById('strengthFill');
const strengthText=document.getElementById('strengthText');

function randomChar(set: string){
  const arr=new Uint32Array(1);
  crypto.getRandomValues(arr);
  return set[arr[0]%set.length];
}

function calculateEntropy(len, poolSize){
  return Math.round(len*Math.log2(poolSize));
}

function updateStrength(password: string,poolSize: number){
  const entropy=calculateEntropy(password.length,poolSize);
  let label="Weak",percent=25;

  if(entropy>40){label="Medium";percent=50;}
  if(entropy>60){label="Strong";percent=75;}
  if(entropy>80){label="Very Strong";percent=100;}

  strengthFill.style.width=percent+"%";
  strengthText.textContent=`Strength: ${label} (${entropy} bits)`;
}

function generatePassword(){
  const length=Number(lengthInput.value);
  const count=Number(countInput.value);
  const exclude=excludeInput.value;

  let sets=[];
  if(uppercase.checked) sets.push(UPPER);
  if(lowercase.checked) sets.push(LOWER);
  if(numbers.checked) sets.push(NUM);
  if(symbols.checked) sets.push(SYM);

  sets=sets.map(s=>s.split('').filter(c=>!exclude.includes(c)).join(''))
           .filter(s=>s.length>0);

  if(sets.length===0) return;

  const pool=sets.join('');
  passwordList.innerHTML='';

  for(let i=0;i<count;i++){
    let password=[];

    // 各種1文字保証
    sets.forEach(set=>{
      password.push(randomChar(set));
    });

    while(password.length<length){
      password.push(randomChar(pool));
    }

    password=password.sort(()=>Math.random()-0.5).join('');

    const div=document.createElement('div');
    div.className='password-item';
    div.innerHTML=`
      <span>${password}</span>
      <button>📋</button>
    `;

    div.querySelector('button').onclick=()=>{
      navigator.clipboard.writeText(password);
    };

    passwordList.appendChild(div);

    if(i===0) updateStrength(password,pool.length);
  }
}

document.getElementById('generate').onclick=generatePassword;
generatePassword();
</script>

<style>
.password-generator{
  max-width:700px;
  margin:auto;
  padding:1rem;
}

.card{
  display:grid;
  gap:1.5rem;
  padding:1.5rem;
  border-radius:1.5rem;
  background:var(--gradient-subtle);
}

.controls{
  display:grid;
  gap:0.8rem;
}

@media(min-width:600px){
  .controls{
    grid-template-columns:repeat(2,1fr);
  }
}

input{
  padding:0.4rem;
  border-radius:0.5rem;
}

.generate-btn{
  padding:1rem;
  font-size:1rem;
  border:none;
  border-radius:1rem;
  background:var(--gradient-accent);
  cursor:pointer;
}

.strength{
  display:grid;
  gap:0.5rem;
}

.strength-bar{
  width:100%;
  height:10px;
  background:#ddd;
  border-radius:10px;
  overflow:hidden;
}

#strengthFill{
  height:100%;
  width:0%;
  background:linear-gradient(90deg,#ff4d4d,#ffa500,#4caf50);
  transition:0.3s;
}

.password-list{
  display:grid;
  gap:0.5rem;
}

.password-item{
  display:flex;
  justify-content:space-between;
  padding:0.8rem;
  border-radius:0.8rem;
  background:white;
  font-family:monospace;
}

/* モバイル最適化 */
@media(max-width:480px){
  .generate-btn{
    position:sticky;
    bottom:0;
  }
}
</style>
